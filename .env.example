# Database
DATABASE_URL="postgresql://tedor:tedor_dev_password@localhost:5434/tedor_dev?schema=public"

# API
PORT=4000
NODE_ENV=development

# Client origins allowed to call the API
WEB_ORIGIN="http://localhost:3000"
MOBILE_ORIGIN="*"

# Email
# Set EMAIL_PROVIDER=smtp and configure SMTP_* for real email delivery.
# Mock mode logs verification/reset links to the server console.
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@tedor.local"
SMTP_SECURE="false"