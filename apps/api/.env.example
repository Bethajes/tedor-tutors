# Local development defaults only. Never commit real secrets.
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL="postgresql://tedor:tedor_dev_password@localhost:5434/tedor_dev?schema=public"

# One long random string per environment. Rotate in production.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Client origins allowed by CORS
WEB_ORIGIN="http://localhost:3000"
MOBILE_ORIGIN="*"

# Telegram bot token used to verify Mini App authentication data server-side
TELEGRAM_BOT_TOKEN="0000000000:REPLACE_ME"

# Email. Mock mode logs verification/reset messages to the server console.
# Set EMAIL_PROVIDER=smtp and configure SMTP_* for real delivery.
#
# Gmail example: create an app password at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification). Then set:
#   EMAIL_PROVIDER="smtp"
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASSWORD="16-character-app-password"
#   SMTP_FROM="you@gmail.com"
#   SMTP_SECURE="false"   # Gmail uses STARTTLS on 587; use true for 465/SSL
EMAIL_PROVIDER="mock"

# SMTP configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Set to "true" for port 465 (SSL), "false" for port 587 (STARTTLS)
SMTP_SECURE="false"

# Seed credentials (dev only)
SEED_SUPER_ADMIN_EMAIL="admin@tedor.local"
SEED_SUPER_ADMIN_PASSWORD="AdminDev123!"
SEED_DEMO_CLIENT_EMAIL="client@tedor.local"
SEED_DEMO_TUTOR_EMAIL="tutor@tedor.local"
SEED_DEMO_PASSWORD="DemoPass123!"